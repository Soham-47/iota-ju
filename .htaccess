RewriteEngine On

# Enable 301 (Permanent) Redirects to update Search Engine index
# This ensures legacy Google links point to the new consolidated /frontend/ structure

# 1. Main Sections
RewriteRule ^ABOUT\ US/(.*)$ /frontend/ABOUT\ US/$1 [R=301,L]
RewriteRule ^ALUMNI/(.*)$ /frontend/ALUMNI/$1 [R=301,L]
RewriteRule ^EVENTS\ \(2\)/(.*)$ /frontend/EVENTS\ (2)/$1 [R=301,L]
RewriteRule ^HOME/(.*)$ /frontend/HOME/$1 [R=301,L]
RewriteRule ^INTRO/(.*)$ /frontend/INTRO/$1 [R=301,L]
RewriteRule ^TIMELINE/(.*)$ /frontend/TIMELINE/$1 [R=301,L]
RewriteRule ^team/(.*)$ /frontend/team/$1 [R=301,L]
RewriteRule ^projects/(.*)$ /frontend/projects/$1 [R=301,L]
RewriteRule ^assets/(.*)$ /frontend/assets/$1 [R=301,L]

# 2. Key Components
RewriteRule ^loading-screen\.(css|js)$ /frontend/loading-screen.$1 [R=301,L]
RewriteRule ^drone-workshop/(.*)$ /frontend/drone-workshop/$1 [R=301,L]

# 3. Root Level
RewriteRule ^index\.html$ /frontend/index.html [R=301,L]

# 4. Default Fallback for Root Access
RewriteRule ^$ /frontend/index.html [L]
